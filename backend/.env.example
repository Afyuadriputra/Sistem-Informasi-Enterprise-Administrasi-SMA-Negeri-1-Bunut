# Configuration for Sistem Informasi Enterprise Administrasi SMA Negeri 1 Bunut (Local Development)
DJANGO_ENV=development
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-production-bunut-2026-xyz
