# Configuration for Sistem Informasi Enterprise Administrasi SMA Negeri 1 Bunut (Integration Environment)
DJANGO_ENV=integration
DJANGO_SECRET_KEY=integration-secret-key-change-for-production-deployment-bunut-xyz123
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=postgresql://sie_app:your_secure_password_here@127.0.0.1:5432/sie_bunut_integration
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=sie_integration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
PRIVATE_MEDIA_ROOT=./private_media
